# Only plugin-specific strings are listed here; generic strings shared with
# KOReader core are already translated by the core catalog.

msgid "Home"
msgstr "Início"

msgid "Open Home"
msgstr "Abrir Início"

msgid "Home display mode"
msgstr "Modo de exibição do Início"

msgid "Debug mode"
msgstr "Modo de depuração"

msgid "Minimum book width"
msgstr "Largura mínima do livro"

msgid "Minimum book width: %1"
msgstr "Largura mínima do livro: %1"

msgid "The smallest width a book cover may use in the Library grid. The maximum width is derived automatically as 1.2x this value. The number of columns adapts to the window width; smaller values fit more books per row."
msgstr "A menor largura que uma capa de livro pode usar na grade da biblioteca. A largura máxima é derivada automaticamente como 1,2 vez este valor. O número de colunas se adapta à largura da janela; valores menores cabem mais livros por linha."

msgid "Recent"
msgstr "Recentes"

msgid "Continue reading"
msgstr "Continuar lendo"

msgid "Last read"
msgstr "Última leitura"

msgid "Read %1%"
msgstr "Lido %1%"

msgid "Read %1% · %2"
msgstr "Lido %1% · %2"

msgid "No books in this folder"
msgstr "Nenhum livro nesta pasta"

msgid "Failed to load Home module:\n"
msgstr "Falha ao carregar o módulo Início:\n"

msgid "Failed to create Home:\n"
msgstr "Falha ao criar o Início:\n"

msgid ""
"A reading-focused home screen with a hero cover for your latest book and a "
"row of recent titles."
msgstr ""
"Uma tela inicial focada na leitura, com uma capa em destaque do seu último "
"livro e uma linha de títulos recentes."

msgid "Greeting"
msgstr "Saudação"

msgid "Greeting text"
msgstr "Texto da saudação"

msgid "Greeting text: %1"
msgstr "Texto da saudação: %1"

msgid "Greeting font"
msgstr "Fonte da saudação"

msgid "Greeting font: %1"
msgstr "Fonte da saudação: %1"

msgid "Greeting font size"
msgstr "Tamanho da fonte da saudação"

msgid "Greeting font size: %1"
msgstr "Tamanho da fonte da saudação: %1"

msgid "Greeting animation speed"
msgstr "Velocidade da animação da saudação"

msgid "Greeting animation speed: %1 ms"
msgstr "Velocidade da animação da saudação: %1 ms"

msgid "Milliseconds between each character reveal. Set to 0 to show the greeting instantly (no animation)."
msgstr "Milissegundos entre a exibição de cada caractere. Defina como 0 para mostrar a saudação instantaneamente (sem animação)."

msgid "Start with"
msgstr "Iniciar com"

msgid "Hi KOReader"
msgstr "Olá, KOReader"

msgid "Charging"
msgstr "Carregando"

msgid "Wi-Fi off"
msgstr "Wi-Fi desligado"

msgid "Wi-Fi not connected"
msgstr "Wi-Fi não conectado"

msgid "Wi-Fi connected"
msgstr "Wi-Fi conectado"
