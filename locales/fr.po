# Only plugin-specific strings are listed here; generic strings shared with
# KOReader core are already translated by the core catalog.

msgid "Home"
msgstr "Accueil"

msgid "Open Home"
msgstr "Ouvrir l'accueil"

msgid "Home display mode"
msgstr "Mode d'affichage de l'accueil"

msgid "Debug mode"
msgstr "Mode débogage"

msgid "Minimum book width"
msgstr "Largeur minimale du livre"

msgid "Minimum book width: %1"
msgstr "Largeur minimale du livre : %1"

msgid "The smallest width a book cover may use in the Library grid. The maximum width is derived automatically as 1.2x this value. The number of columns adapts to the window width; smaller values fit more books per row."
msgstr "La largeur minimale qu'une couverture de livre peut occuper dans la grille de la bibliothèque. La largeur maximale est dérivée automatiquement à 1,2 fois cette valeur. Le nombre de colonnes s'adapte à la largeur de la fenêtre ; des valeurs plus petites permettent d'afficher plus de livres par rangée."

msgid "Recent"
msgstr "Récents"

msgid "Continue reading"
msgstr "Continuer la lecture"

msgid "Last read"
msgstr "Dernière lecture"

msgid "Read %1%"
msgstr "Lu %1%"

msgid "Read %1% · %2"
msgstr "Lu %1% · %2"

msgid "No books in this folder"
msgstr "Aucun livre dans ce dossier"

msgid "Failed to load Home module:\n"
msgstr "Échec du chargement du module Accueil :\n"

msgid "Failed to create Home:\n"
msgstr "Échec de la création de l'accueil :\n"

msgid ""
"A reading-focused home screen with a hero cover for your latest book and a "
"row of recent titles."
msgstr ""
"Un écran d'accueil axé sur la lecture, avec une grande couverture de votre "
"dernier livre et une rangée de titres récents."

msgid "Greeting"
msgstr "Message d'accueil"

msgid "Greeting text"
msgstr "Texte d'accueil"

msgid "Greeting text: %1"
msgstr "Texte d'accueil : %1"

msgid "Greeting font"
msgstr "Police d'accueil"

msgid "Greeting font: %1"
msgstr "Police d'accueil : %1"

msgid "Greeting font size"
msgstr "Taille de police d'accueil"

msgid "Greeting font size: %1"
msgstr "Taille de police d'accueil : %1"

msgid "Greeting animation speed"
msgstr "Vitesse d’animation du message d’accueil"

msgid "Greeting animation speed: %1 ms"
msgstr "Vitesse d’animation du message d’accueil : %1 ms"

msgid "Milliseconds between each character reveal. Set to 0 to show the greeting instantly (no animation)."
msgstr "Millisecondes entre l’apparition de chaque caractère. Réglez sur 0 pour afficher le message d’accueil instantanément (sans animation)."

msgid "Start with"
msgstr "Démarrer avec"

msgid "Hi KOReader"
msgstr "Bonjour KOReader"

msgid "Charging"
msgstr "En charge"

msgid "Wi-Fi off"
msgstr "Wi-Fi désactivé"

msgid "Wi-Fi not connected"
msgstr "Wi-Fi non connecté"

msgid "Wi-Fi connected"
msgstr "Wi-Fi connecté"
