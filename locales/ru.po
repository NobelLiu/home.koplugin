# Only plugin-specific strings are listed here; generic strings shared with
# KOReader core are already translated by the core catalog.

msgid "Home"
msgstr "Главная"

msgid "Open Home"
msgstr "Открыть главный экран"

msgid "Home display mode"
msgstr "Режим отображения главного экрана"

msgid "Debug mode"
msgstr "Режим отладки"

msgid "Minimum book width"
msgstr "Минимальная ширина книги"

msgid "Minimum book width: %1"
msgstr "Минимальная ширина книги: %1"

msgid "The smallest width a book cover may use in the Library grid. The maximum width is derived automatically as 1.2x this value. The number of columns adapts to the window width; smaller values fit more books per row."
msgstr "Минимальная ширина обложки книги в сетке библиотеки. Максимальная ширина автоматически вычисляется как 1,2 от этого значения. Количество столбцов подстраивается под ширину окна; меньшие значения позволяют разместить больше книг в ряду."

msgid "Recent"
msgstr "Недавние"

msgid "Continue reading"
msgstr "Продолжить чтение"

msgid "Last read"
msgstr "Последнее чтение"

msgid "Read %1%"
msgstr "Прочитано %1%"

msgid "Read %1% · %2"
msgstr "Прочитано %1% · %2"

msgid "No books in this folder"
msgstr "В этой папке нет книг"

msgid "Failed to load Home module:\n"
msgstr "Не удалось загрузить модуль главного экрана:\n"

msgid "Failed to create Home:\n"
msgstr "Не удалось создать главный экран:\n"

msgid ""
"A reading-focused home screen with a hero cover for your latest book and a "
"row of recent titles."
msgstr ""
"Ориентированный на чтение главный экран с крупной обложкой последней книги и "
"рядом недавних изданий."

msgid "Greeting"
msgstr "Приветствие"

msgid "Greeting text"
msgstr "Текст приветствия"

msgid "Greeting text: %1"
msgstr "Текст приветствия: %1"

msgid "Greeting font"
msgstr "Шрифт приветствия"

msgid "Greeting font: %1"
msgstr "Шрифт приветствия: %1"

msgid "Greeting font size"
msgstr "Размер шрифта приветствия"

msgid "Greeting font size: %1"
msgstr "Размер шрифта приветствия: %1"

msgid "Greeting animation speed"
msgstr "Скорость анимации приветствия"

msgid "Greeting animation speed: %1 ms"
msgstr "Скорость анимации приветствия: %1 мс"

msgid "Milliseconds between each character reveal. Set to 0 to show the greeting instantly (no animation)."
msgstr "Миллисекунды между появлением каждого символа. Установите 0, чтобы показывать приветствие сразу (без анимации)."

msgid "Start with"
msgstr "Начинать с"

msgid "Hi KOReader"
msgstr "Привет, KOReader"

msgid "Charging"
msgstr "Зарядка"

msgid "Wi-Fi off"
msgstr "Wi-Fi выключен"

msgid "Wi-Fi not connected"
msgstr "Wi-Fi не подключён"

msgid "Wi-Fi connected"
msgstr "Wi-Fi подключён"
