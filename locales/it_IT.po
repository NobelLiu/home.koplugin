# Only plugin-specific strings are listed here; generic strings shared with
# KOReader core are already translated by the core catalog.

msgid "Home"
msgstr "Home"

msgid "Open Home"
msgstr "Apri Home"

msgid "Home display mode"
msgstr "Modalità di visualizzazione Home"

msgid "Debug mode"
msgstr "Modalità debug"

msgid "Minimal book width"
msgstr "Larghezza minima del libro"

msgid "Minimal book width: %1 pt"
msgstr "Larghezza minima del libro: %1 pt"

msgid "Design pt for the smallest book cover width in the Library grid. Converted to device pixels via screen scale. Maximum is 1.2× this value. Smaller values fit more books per row."
msgstr "Punti di design (pt) per la larghezza minima della copertina nella griglia della libreria. Convertiti in pixel del dispositivo in base alla scala dello schermo. Il massimo è 1,2 volte questo valore. Valori più piccoli consentono più libri per riga."

msgid "Recent"
msgstr "Recenti"

msgid "Continue reading"
msgstr "Continua a leggere"

msgid "Last read"
msgstr "Ultima lettura"

msgid "Read %1%"
msgstr "Letto %1%"

msgid "Read %1% · %2"
msgstr "Letto %1% · %2"

msgid "No books in this folder"
msgstr "Nessun libro in questa cartella"

msgid "Failed to load Home module:\n"
msgstr "Impossibile caricare il modulo Home:\n"

msgid "Failed to create Home:\n"
msgstr "Impossibile creare la Home:\n"

msgid ""
"A reading-focused home screen with a hero cover for your latest book and a "
"row of recent titles."
msgstr ""
"Una schermata iniziale incentrata sulla lettura, con una copertina in "
"evidenza dell'ultimo libro e una riga di titoli recenti."

msgid "Greeting"
msgstr "Saluto"

msgid "Greeting text"
msgstr "Testo del saluto"

msgid "Greeting text: %1"
msgstr "Testo del saluto: %1"

msgid "Greeting font"
msgstr "Carattere del saluto"

msgid "Greeting font: %1"
msgstr "Carattere del saluto: %1"

msgid "Greeting font size"
msgstr "Dimensione carattere del saluto"

msgid "Greeting font size: %1"
msgstr "Dimensione carattere del saluto: %1"

msgid "Greeting animation speed"
msgstr "Velocità animazione del saluto"

msgid "Greeting animation speed: %1 ms"
msgstr "Velocità animazione del saluto: %1 ms"

msgid "Milliseconds between each character reveal. Set to 0 to show the greeting instantly (no animation)."
msgstr "Millisecondi tra la comparsa di ciascun carattere. Imposta a 0 per mostrare il saluto istantaneamente (nessuna animazione)."

msgid "Start with"
msgstr "Avvia con"

msgid "Hi KOReader"
msgstr "Ciao KOReader"

msgid "Charging"
msgstr "In carica"

msgid "Wi-Fi off"
msgstr "Wi-Fi disattivato"

msgid "Wi-Fi not connected"
msgstr "Wi-Fi non connesso"

msgid "Wi-Fi connected"
msgstr "Wi-Fi connesso"
