# Only plugin-specific strings are listed here; generic strings shared with
# KOReader core are already translated by the core catalog.

msgid "Home"
msgstr "Ana ekran"

msgid "Open Home"
msgstr "Ana sayfayı aç"

msgid "Home display mode"
msgstr "Ana sayfa görüntüleme modu"

msgid "Debug mode"
msgstr "Hata ayıklama modu"

msgid "Minimal book width"
msgstr "Minimal kitap genişliği"

msgid "Minimal book width: %1 pt"
msgstr "Minimal kitap genişliği: %1 pt"

msgid "Design pt for the smallest book cover width in the Library grid. Converted to device pixels via screen scale. Maximum is 1.2× this value. Smaller values fit more books per row."
msgstr "Kitaplık ızgarasındaki kitap kapağının en küçük genişliği için tasarım pt değeri. Ekran ölçeğiyle aygıt pikseline çevrilir. Maksimum bu değerin 1,2 katıdır. Daha küçük değerler satır başına daha fazla kitap sığdırır."

msgid "Recent"
msgstr "Son"

msgid "Continue reading"
msgstr "Okumaya devam et"

msgid "Last read"
msgstr "Son okunan"

msgid "Read %1%"
msgstr "%1% okundu"

msgid "Read %1% · %2"
msgstr "%1% okundu · %2"

msgid "No books in this folder"
msgstr "Bu klasörde kitap yok"

msgid "Failed to load Home module:\n"
msgstr "Ana sayfa modülü yüklenemedi:\n"

msgid "Failed to create Home:\n"
msgstr "Ana sayfa oluşturulamadı:\n"

msgid ""
"A reading-focused home screen with a hero cover for your latest book and a "
"row of recent titles."
msgstr ""
"En son kitabın büyük kapağı ve bir sıra son başlıkla okumaya odaklı ana "
"sayfa."

msgid "Greeting"
msgstr "Karşılama"

msgid "Greeting text"
msgstr "Karşılama metni"

msgid "Greeting text: %1"
msgstr "Karşılama metni: %1"

msgid "Greeting font"
msgstr "Karşılama yazı tipi"

msgid "Greeting font: %1"
msgstr "Karşılama yazı tipi: %1"

msgid "Greeting font size"
msgstr "Karşılama yazı tipi boyutu"

msgid "Greeting font size: %1"
msgstr "Karşılama yazı tipi boyutu: %1"

msgid "Greeting animation speed"
msgstr "Karşılama animasyonu hızı"

msgid "Greeting animation speed: %1 ms"
msgstr "Karşılama animasyonu hızı: %1 ms"

msgid "Milliseconds between each character reveal. Set to 0 to show the greeting instantly (no animation)."
msgstr "Her karakterin görünmesi arasındaki milisaniye. Karşılamayı anında göstermek için 0 olarak ayarlayın (animasyon yok)."

msgid "Start with"
msgstr "Şununla başla"

msgid "Hi KOReader"
msgstr "Merhaba KOReader"

msgid "Charging"
msgstr "Şarj oluyor"

msgid "Wi-Fi off"
msgstr "Wi-Fi kapalı"

msgid "Wi-Fi not connected"
msgstr "Wi-Fi bağlı değil"

msgid "Wi-Fi connected"
msgstr "Wi-Fi bağlı"
