# Only plugin-specific strings are listed here; generic strings shared with
# KOReader core are already translated by the core catalog.

msgid "Home"
msgstr "Inicio"

msgid "Open Home"
msgstr "Abrir Inicio"

msgid "Home display mode"
msgstr "Modo de visualización de Inicio"

msgid "Debug mode"
msgstr "Modo de depuración"

msgid "Minimal book width"
msgstr "Ancho mínimo del libro"

msgid "Minimal book width: %1 pt"
msgstr "Ancho mínimo del libro: %1 pt"

msgid "Design pt for the smallest book cover width in the Library grid. Converted to device pixels via screen scale. Maximum is 1.2× this value. Smaller values fit more books per row."
msgstr "Puntos de diseño (pt) para el ancho más pequeño de portada en la cuadrícula de la biblioteca. Se convierten a píxeles del dispositivo según la escala de pantalla. El máximo es 1,2 veces este valor. Los valores más pequeños permiten más libros por fila."

msgid "Recent"
msgstr "Recientes"

msgid "Continue reading"
msgstr "Continuar leyendo"

msgid "Last read"
msgstr "Última lectura"

msgid "Read %1%"
msgstr "Leído %1%"

msgid "Read %1% · %2"
msgstr "Leído %1% · %2"

msgid "No books in this folder"
msgstr "No hay libros en esta carpeta"

msgid "Failed to load Home module:\n"
msgstr "No se pudo cargar el módulo de Inicio:\n"

msgid "Failed to create Home:\n"
msgstr "No se pudo crear Inicio:\n"

msgid ""
"A reading-focused home screen with a hero cover for your latest book and a "
"row of recent titles."
msgstr ""
"Una pantalla de inicio centrada en la lectura, con una portada destacada de "
"tu último libro y una fila de títulos recientes."

msgid "Greeting"
msgstr "Saludo"

msgid "Greeting text"
msgstr "Texto del saludo"

msgid "Greeting text: %1"
msgstr "Texto del saludo: %1"

msgid "Greeting font"
msgstr "Fuente del saludo"

msgid "Greeting font: %1"
msgstr "Fuente del saludo: %1"

msgid "Greeting font size"
msgstr "Tamaño de fuente del saludo"

msgid "Greeting font size: %1"
msgstr "Tamaño de fuente del saludo: %1"

msgid "Greeting animation speed"
msgstr "Velocidad de animación del saludo"

msgid "Greeting animation speed: %1 ms"
msgstr "Velocidad de animación del saludo: %1 ms"

msgid "Milliseconds between each character reveal. Set to 0 to show the greeting instantly (no animation)."
msgstr "Milisegundos entre la aparición de cada carácter. Ponlo a 0 para mostrar el saludo al instante (sin animación)."

msgid "Start with"
msgstr "Iniciar con"

msgid "Hi KOReader"
msgstr "Hola, KOReader"

msgid "Charging"
msgstr "Cargando"

msgid "Wi-Fi off"
msgstr "Wi-Fi desactivado"

msgid "Wi-Fi not connected"
msgstr "Wi-Fi no conectado"

msgid "Wi-Fi connected"
msgstr "Wi-Fi conectado"
