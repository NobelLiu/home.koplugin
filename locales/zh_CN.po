# Only plugin-specific strings are listed here. Generic strings shared with
# KOReader core (e.g. Home, Continue, Name, Cancel, Save, Default, Sort by,
# Display mode, N/A, file browser, "Start with: %1") are already translated by
# the core catalog, which loads before this plugin's i18n injection.

msgid "Home"
msgstr "主页"

msgid "Open Home"
msgstr "打开主页"

msgid "Home display mode"
msgstr "主页显示模式"

msgid "Debug mode"
msgstr "调试模式"

msgid "Library"
msgstr "图书馆"

msgid "Shelf rows"
msgstr "书架层数"

msgid "Shelf rows: %1"
msgstr "书架层数：%1"

msgid "Number of visible shelf rows in the Library. Book size and spacing are computed automatically from the row count. Use a two-finger pinch on the grid to adjust quickly."
msgstr "图书馆可见的书架层数。书本尺寸与间距会根据层数自动计算。可在书格上双指捏合/张开快速调整。"

msgid "Continue reading"
msgstr "继续阅读"

msgid "Last read"
msgstr "最近阅读"

msgid "Read %1%"
msgstr "已读 %1%"

msgid "Read %1% · %2"
msgstr "已读 %1% · %2"

msgid "No books in this folder"
msgstr "此文件夹中没有书籍"

msgid "Failed to load Home module:\n"
msgstr "加载 Home 模块失败：\n"

msgid "Failed to create Home:\n"
msgstr "创建 Home 失败：\n"

msgid ""
"A reading-focused home screen with a hero cover for your latest book and a "
"Library grid of your books."
msgstr "以阅读为主页，展示最新书籍的大封面和你的图书馆网格。"

msgid "Greeting"
msgstr "问候语"

msgid "Greeting text"
msgstr "问候语文本"

