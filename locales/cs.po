# Only plugin-specific strings are listed here; generic strings shared with
# KOReader core are already translated by the core catalog.

msgid "Home"
msgstr "Domů"

msgid "Open Home"
msgstr "Otevřít domovskou stránku"

msgid "Home display mode"
msgstr "Režim zobrazení domovské stránky"

msgid "Debug mode"
msgstr "Režim ladění"

msgid "Minimum book width"
msgstr "Minimální šířka knihy"

msgid "Minimum book width: %1"
msgstr "Minimální šířka knihy: %1"

msgid "The smallest width a book cover may use in the Library grid. The maximum width is derived automatically as 1.2x this value. The number of columns adapts to the window width; smaller values fit more books per row."
msgstr "Nejmenší šířka, kterou může obálka knihy v mřížce knihovny použít. Maximální šířka se automaticky odvodí jako 1,2násobek této hodnoty. Počet sloupců se přizpůsobuje šířce okna; menší hodnoty umožňují více knih v řádku."

msgid "Recent"
msgstr "Nedávné"

msgid "Continue reading"
msgstr "Pokračovat ve čtení"

msgid "Last read"
msgstr "Naposledy čteno"

msgid "Read %1%"
msgstr "Přečteno %1%"

msgid "Read %1% · %2"
msgstr "Přečteno %1% · %2"

msgid "No books in this folder"
msgstr "V této složce nejsou žádné knihy"

msgid "Failed to load Home module:\n"
msgstr "Nepodařilo se načíst modul Domů:\n"

msgid "Failed to create Home:\n"
msgstr "Nepodařilo se vytvořit Domů:\n"

msgid ""
"A reading-focused home screen with a hero cover for your latest book and a "
"row of recent titles."
msgstr ""
"Domovská obrazovka zaměřená na čtení s velkým obalem poslední knihy a řadou "
"nedávných titulů."

msgid "Greeting"
msgstr "Pozdrav"

msgid "Greeting text"
msgstr "Text pozdravu"

msgid "Greeting text: %1"
msgstr "Text pozdravu: %1"

msgid "Greeting font"
msgstr "Písmo pozdravu"

msgid "Greeting font: %1"
msgstr "Písmo pozdravu: %1"

msgid "Greeting font size"
msgstr "Velikost písma pozdravu"

msgid "Greeting font size: %1"
msgstr "Velikost písma pozdravu: %1"

msgid "Greeting animation speed"
msgstr "Rychlost animace pozdravu"

msgid "Greeting animation speed: %1 ms"
msgstr "Rychlost animace pozdravu: %1 ms"

msgid "Milliseconds between each character reveal. Set to 0 to show the greeting instantly (no animation)."
msgstr "Milisekundy mezi zobrazením jednotlivých znaků. Nastavte na 0 pro okamžité zobrazení pozdravu (bez animace)."

msgid "Start with"
msgstr "Spustit s"

msgid "Hi KOReader"
msgstr "Ahoj, KOReadere"

msgid "Charging"
msgstr "Nabíjení"

msgid "Wi-Fi off"
msgstr "Wi-Fi vypnuto"

msgid "Wi-Fi not connected"
msgstr "Wi-Fi nepřipojeno"

msgid "Wi-Fi connected"
msgstr "Wi-Fi připojeno"
