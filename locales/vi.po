# Only plugin-specific strings are listed here; generic strings shared with
# KOReader core are already translated by the core catalog.

msgid "Home"
msgstr "Trang chính"

msgid "Open Home"
msgstr "Mở trang chủ"

msgid "Home display mode"
msgstr "Chế độ hiển thị trang chủ"

msgid "Debug mode"
msgstr "Chế độ gỡ lỗi"

msgid "Minimal book width"
msgstr "Chiều rộng tối thiểu của sách"

msgid "Minimal book width: %1 pt"
msgstr "Chiều rộng tối thiểu của sách: %1 pt"

msgid "Design pt for the smallest book cover width in the Library grid. Converted to device pixels via screen scale. Maximum is 1.2× this value. Smaller values fit more books per row."
msgstr "Điểm thiết kế (pt) cho chiều rộng bìa sách nhỏ nhất trong lưới thư viện. Được quy đổi sang pixel thiết bị theo tỉ lệ màn hình. Tối đa bằng 1,2 lần giá trị này. Giá trị nhỏ hơn giúp xếp nhiều sách hơn mỗi hàng."

msgid "Recent"
msgstr "Gần đây"

msgid "Continue reading"
msgstr "Tiếp tục đọc"

msgid "Last read"
msgstr "Đọc gần nhất"

msgid "Read %1%"
msgstr "Đã đọc %1%"

msgid "Read %1% · %2"
msgstr "Đã đọc %1% · %2"

msgid "No books in this folder"
msgstr "Không có sách trong thư mục này"

msgid "Failed to load Home module:\n"
msgstr "Không thể tải mô-đun Trang chủ:\n"

msgid "Failed to create Home:\n"
msgstr "Không thể tạo Trang chủ:\n"

msgid ""
"A reading-focused home screen with a hero cover for your latest book and a "
"row of recent titles."
msgstr ""
"Màn hình trang chủ tập trung vào đọc sách, với bìa lớn của cuốn sách mới "
"nhất và một hàng các tựa sách gần đây."

msgid "Greeting"
msgstr "Lời chào"

msgid "Greeting text"
msgstr "Nội dung lời chào"

msgid "Greeting text: %1"
msgstr "Nội dung lời chào: %1"

msgid "Greeting font"
msgstr "Phông chữ lời chào"

msgid "Greeting font: %1"
msgstr "Phông chữ lời chào: %1"

msgid "Greeting font size"
msgstr "Cỡ chữ lời chào"

msgid "Greeting font size: %1"
msgstr "Cỡ chữ lời chào: %1"

msgid "Greeting animation speed"
msgstr "Tốc độ hoạt ảnh lời chào"

msgid "Greeting animation speed: %1 ms"
msgstr "Tốc độ hoạt ảnh lời chào: %1 ms"

msgid "Milliseconds between each character reveal. Set to 0 to show the greeting instantly (no animation)."
msgstr "Số mili-giây giữa mỗi lần hiện ký tự. Đặt về 0 để hiển thị lời chào ngay lập tức (không hoạt ảnh)."

msgid "Start with"
msgstr "Bắt đầu với"

msgid "Hi KOReader"
msgstr "Chào KOReader"

msgid "Charging"
msgstr "Đang sạc"

msgid "Wi-Fi off"
msgstr "Wi-Fi tắt"

msgid "Wi-Fi not connected"
msgstr "Wi-Fi chưa kết nối"

msgid "Wi-Fi connected"
msgstr "Wi-Fi đã kết nối"
