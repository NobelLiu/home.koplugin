# Only plugin-specific strings are listed here; generic strings shared with
# KOReader core are already translated by the core catalog.

msgid "Home"
msgstr "Головна"

msgid "Open Home"
msgstr "Відкрити головну"

msgid "Home display mode"
msgstr "Режим відображення головної"

msgid "Debug mode"
msgstr "Режим налагодження"

msgid "Minimal book width"
msgstr "Мінімальна ширина книги"

msgid "Minimal book width: %1 pt"
msgstr "Мінімальна ширина книги: %1 pt"

msgid "Design pt for the smallest book cover width in the Library grid. Converted to device pixels via screen scale. Maximum is 1.2× this value. Smaller values fit more books per row."
msgstr "Дизайн-пункти (pt) для найменшої ширини обкладинки в сітці бібліотеки. Перераховуються в пікселі пристрою за масштабом екрана. Максимум — 1,2 від цього значення. Менші значення дають змогу розмістити більше книг у рядку."

msgid "Recent"
msgstr "Нещодавні"

msgid "Continue reading"
msgstr "Продовжити читання"

msgid "Last read"
msgstr "Останнє читання"

msgid "Read %1%"
msgstr "Прочитано %1%"

msgid "Read %1% · %2"
msgstr "Прочитано %1% · %2"

msgid "No books in this folder"
msgstr "У цій теці немає книг"

msgid "Failed to load Home module:\n"
msgstr "Не вдалося завантажити модуль «Головна»:\n"

msgid "Failed to create Home:\n"
msgstr "Не вдалося створити «Головну»:\n"

msgid ""
"A reading-focused home screen with a hero cover for your latest book and a "
"row of recent titles."
msgstr ""
"Домашній екран для читання з великою обкладинкою останньої книги та рядом "
"нещодавніх назв."

msgid "Greeting"
msgstr "Привітання"

msgid "Greeting text"
msgstr "Текст привітання"

msgid "Greeting text: %1"
msgstr "Текст привітання: %1"

msgid "Greeting font"
msgstr "Шрифт привітання"

msgid "Greeting font: %1"
msgstr "Шрифт привітання: %1"

msgid "Greeting font size"
msgstr "Розмір шрифту привітання"

msgid "Greeting font size: %1"
msgstr "Розмір шрифту привітання: %1"

msgid "Greeting animation speed"
msgstr "Швидкість анімації привітання"

msgid "Greeting animation speed: %1 ms"
msgstr "Швидкість анімації привітання: %1 мс"

msgid "Milliseconds between each character reveal. Set to 0 to show the greeting instantly (no animation)."
msgstr "Мілісекунди між появою кожного символу. Встановіть 0, щоб показувати привітання одразу (без анімації)."

msgid "Start with"
msgstr "Починати з"

msgid "Hi KOReader"
msgstr "Привіт, KOReader"

msgid "Charging"
msgstr "Заряджання"

msgid "Wi-Fi off"
msgstr "Wi-Fi вимкнено"

msgid "Wi-Fi not connected"
msgstr "Wi-Fi не під'єднано"

msgid "Wi-Fi connected"
msgstr "Wi-Fi під'єднано"
